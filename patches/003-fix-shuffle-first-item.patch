diff --git a/xbmc/music/MusicUtils.cpp b/xbmc/music/MusicUtils.cpp
index b86143e271..3273e661c8 100644
--- a/xbmc/music/MusicUtils.cpp
+++ b/xbmc/music/MusicUtils.cpp
@@ -683,8 +683,13 @@ void AddItemToPlayListAndPlay(const std::shared_ptr<CFileItem>& itemToQueue,
 
   if (playlistPlayer.IsShuffled(PLAYLIST::TYPE_MUSIC))
   {
-    playList.Swap(0, playList.FindOrder(pos));
-    pos = 0;
+    if (itemToPlay)
+    {
+      // a specific item was clicked - keep it playing first
+      playList.Swap(0, playList.FindOrder(pos));
+      pos = 0;
+    }
+    // else: no specific item requested, list is already shuffled - play from pos 0 as-is
   }
 
   playlistPlayer.SetCurrentPlaylist(PLAYLIST::TYPE_MUSIC);
