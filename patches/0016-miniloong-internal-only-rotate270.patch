+// dArkOS: some rk3566 handhelds (e.g. the miniloong) have a physically
+// portrait panel used in landscape and need the RGA software rotation path
+// (see RGARotate.h). Rather than gating that at compile time, detect it at
+// Kodi startup by checking the device identity file dArkOS writes for every
+// device. Read once and cached for the life of the process.
+const std::string MINILOONG_DEVICE_FILE = "/home/ark/.config/.DEVICE";
+const std::string MINILOONG_DEVICE_TAG = "rotated";
+
+bool IsMiniloongDevice()
+{
+  static const bool isMiniloong = []()
+  {
+    std::ifstream deviceFile(MINILOONG_DEVICE_FILE);
+    if (!deviceFile.is_open())
+      return false;
+
+    std::string contents((std::istreambuf_iterator<char>(deviceFile)),
+                          std::istreambuf_iterator<char>());
+
+    // Case-insensitive match — dArkOS doesn't guarantee a specific casing for
+    // the contents of .DEVICE, so compare lowercased copies of both sides.
+    std::transform(contents.begin(), contents.end(), contents.begin(),
+                    [](unsigned char c) { return std::tolower(c); });
+
+    std::string tag = MINILOONG_DEVICE_TAG;
+    std::transform(tag.begin(), tag.end(), tag.begin(),
+                    [](unsigned char c) { return std::tolower(c); });
+
+    return contents.find(tag) != std::string::npos;
+  }();
+
+  return isMiniloong;
+}
